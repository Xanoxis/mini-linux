#!/bin/sh
# watch info - one screen of status for the round display.
echo "$(cat /usr/share/urbane/release 2>/dev/null || echo "Mini Linux")  $(hostname)"
echo "kernel $(uname -r)"
uptime | sed 's/^ *//'
echo
watch-charge 2>/dev/null | head -n 4
echo
free -m | awk 'NR == 2 {print "RAM  " $3 "/" $2 " MB used"} NR == 3 {print "Swap " $3 "/" $2 " MB used"}'
echo
ip -4 -br addr 2>/dev/null | awk '$1 != "lo" {print $1 " " $3}'
w=$(iw dev wlan0 link 2>/dev/null | sed -n 's/^\tSSID: //p')
[ -n "$w" ] && echo "WiFi $w"
