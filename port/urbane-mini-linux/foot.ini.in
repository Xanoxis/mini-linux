# Generated by watch-viewport from /usr/share/urbane/foot.ini.in - edits are overwritten.
# Change settings with: watch-viewport round|balanced|full|+|-
[main]
font=@FONT@:pixelsize=@FONT_PX@
dpi-aware=no
pad=@PAD@x@PAD@ center
initial-window-mode=fullscreen
# xterm-256color ships in ncurses-terminfo-base; "foot" terminfo may not be installed
term=xterm-256color

[colors-dark]
# pure black background: OLED pixels stay off, saves battery and burn-in
background=000000
foreground=d8d8d8

[cursor]
style=block
blink=no

[scrollback]
lines=1000

[mouse]
hide-when-typing=yes

[key-bindings]
font-increase=Control+plus Control+equal Control+KP_Add
font-decrease=Control+minus Control+KP_Subtract
font-reset=Control+0 Control+KP_0
